# Huisturf - environment variabelen
# Kopieer dit bestand naar .env.local en vul je eigen Supabase waarden in.

# Te vinden in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Service role key (ALLEEN server-side gebruikt, NOOIT in de browser).
# Nodig voor admin acties zoals het aanmaken van bewoners-accounts en imports.
# Te vinden in Supabase: Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Preview/demo modus: zet op 1 om de app met mockdata te bekijken zonder
# Supabase backend (login + database niet nodig). Laat leeg voor productie.
# DEMO_MODE=1
