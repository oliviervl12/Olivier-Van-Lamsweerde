# N8N Huisartsen Scraper Configuration Template
# Copy this file to .env and fill in your credentials

# ===========================================
# Google Maps API Configuration
# ===========================================
# Get your API key from: https://console.cloud.google.com/apis
# Required APIs: Places API, Geocoding API (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# Google Sheets Configuration
# ===========================================
# Your Google Sheets spreadsheet ID
# Find it in the URL: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet/Tab names (must match exactly)
SHEET_NAME_PRACTICE_INFO=Practice Info
SHEET_NAME_DOCTOR_DETAILS=Doctor Details
SHEET_NAME_CONTACT_INFO=Contact Information

# ===========================================
# OpenAI API Configuration (or alternative LLM)
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for extraction (gpt-4 recommended for accuracy)
OPENAI_MODEL=gpt-4
# Alternative: gpt-3.5-turbo (faster, cheaper, less accurate)
# OPENAI_MODEL=gpt-3.5-turbo

# ===========================================
# Alternative LLM Configurations
# ===========================================
# If using local LLM (Ollama, LM Studio, etc.)
# LOCAL_LLM_ENABLED=false
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama2

# If using Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ===========================================
# Search Configuration
# ===========================================
# Default search query
SEARCH_QUERY=huisartsenpraktijk

# Country/region to focus on
SEARCH_COUNTRY=Netherlands

# Specific cities (comma-separated, optional)
# SEARCH_CITIES=Amsterdam,Rotterdam,Utrecht,Den Haag,Eindhoven

# Maximum results to process per search
MAX_RESULTS_PER_SEARCH=20

# ===========================================
# Rate Limiting & Performance
# ===========================================
# Delay between API requests (milliseconds)
RATE_LIMIT_DELAY_MS=2000

# Delay between website scraping requests (milliseconds)
WEBSITE_SCRAPE_DELAY_MS=3000

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=3

# Request timeout (milliseconds)
REQUEST_TIMEOUT_MS=30000

# ===========================================
# Scraping Configuration
# ===========================================
# User agent for web requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Respect robots.txt
RESPECT_ROBOTS_TXT=true

# Maximum retries for failed requests
MAX_RETRIES=3

# ===========================================
# Data Quality & Validation
# ===========================================
# Minimum confidence score for AI extraction (0-1)
MIN_CONFIDENCE_SCORE=0.7

# Skip practices without websites
SKIP_PRACTICES_WITHOUT_WEBSITE=false

# Validate email addresses
VALIDATE_EMAILS=true

# Validate phone numbers (Dutch format)
VALIDATE_PHONE_NUMBERS=true

# ===========================================
# Scheduling (if using scheduled trigger)
# ===========================================
# Run schedule: cron format or interval
# Examples:
#   - "0 */6 * * *" (every 6 hours)
#   - "0 9 * * *" (daily at 9 AM)
#   - "0 9 * * 1" (every Monday at 9 AM)
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 */6 * * *

# ===========================================
# Notifications (optional)
# ===========================================
# Email notifications on completion/errors
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL=your_email@example.com

# Slack webhook for notifications
SLACK_WEBHOOK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===========================================
# Logging & Debugging
# ===========================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Save execution logs
SAVE_EXECUTION_LOGS=true

# Enable verbose mode (detailed logging)
VERBOSE_MODE=false

# ===========================================
# Data Storage & Backup
# ===========================================
# Enable local backup before writing to sheets
LOCAL_BACKUP_ENABLED=true
LOCAL_BACKUP_PATH=./backups

# Backup format: json, csv
BACKUP_FORMAT=json

# Keep backups for (days)
BACKUP_RETENTION_DAYS=30

# ===========================================
# Advanced Options
# ===========================================
# Use alternative data source (Zorgkaart Nederland)
USE_ZORGKAART_ALTERNATIVE=false

# Combine multiple data sources
COMBINE_DATA_SOURCES=true

# Deduplicate results
DEDUPLICATE_RESULTS=true

# Update existing records (vs append only)
UPDATE_EXISTING_RECORDS=false

# ===========================================
# Compliance & Privacy
# ===========================================
# GDPR compliance mode
GDPR_COMPLIANCE_MODE=true

# Anonymize sensitive data in logs
ANONYMIZE_LOGS=true

# Data retention period (days, 0 = indefinite)
DATA_RETENTION_DAYS=365

# ===========================================
# Notes
# ===========================================
# 1. Never commit this file with real credentials to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Monitor your API usage and costs
# 4. Respect rate limits and terms of service
# 5. Ensure GDPR compliance when handling personal data
# 6. Test thoroughly before running at scale

# ===========================================
# Support
# ===========================================
# For issues and questions:
# - N8N Documentation: https://docs.n8n.io/
# - Google Maps API: https://developers.google.com/maps
# - OpenAI API: https://platform.openai.com/docs
